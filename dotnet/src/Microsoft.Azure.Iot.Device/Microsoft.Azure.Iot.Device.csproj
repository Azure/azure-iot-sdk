<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <VersionPrefix>1.1.0</VersionPrefix>
  </PropertyGroup>

  <!-- NuGet package metadata. The repository URL is what links the published package to this
       repository on GitHub Packages, so keep it pointed at the canonical repository. -->
  <PropertyGroup>
    <PackageId>Microsoft.Azure.Iot.Device</PackageId>
    <Authors>Microsoft</Authors>
    <Company>Microsoft</Company>
    <Product>Microsoft Azure IoT Device Client SDK</Product>
    <Description>Device client SDK for connecting devices to Azure IoT hub and the Azure Device Provisioning Service over MQTT.</Description>
    <Copyright>© Microsoft Corporation. All rights reserved.</Copyright>
    <PackageTags>Azure;IoT;IoTHub;DPS;Provisioning;MQTT;Device;SDK</PackageTags>
    <PackageProjectUrl>https://github.com/Azure/azure-iot-sdk</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Azure/azure-iot-sdk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <!-- Source Link. GitHub Packages does not accept .snupkg symbol packages, so the symbols and the
       sources they point at are embedded in the assembly itself instead. -->
  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>embedded</DebugType>
    <IncludeSymbols>false</IncludeSymbols>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Add strong name signing properties for release pipeline compatibility -->
  <PropertyGroup>
    <AssemblyOriginatorKeyFile>$(MSBuildProjectDirectory)\..\..\MSSharedLibKey.snk</AssemblyOriginatorKeyFile>
    <SignAssembly>true</SignAssembly>
    <PublicSign>true</PublicSign>
    <DelaySign>false</DelaySign>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <!-- protoc and friends; needed to build, never at runtime, so it stays out of the package's dependencies. -->
    <PackageReference Include="Google.Protobuf.Tools" Version="3.34.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Grpc.Tools" Version="2.80.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="MQTTnet" Version="5.1.0.1559" />
  </ItemGroup>

  <ItemGroup>
    <!--This default config puts the generated files only in the obj/debug/net10.0/Protos/Directmethods.cs file-->
    <Protobuf Include="..\..\..\common\Protos\presence.proto" />
    <Protobuf Include="..\..\..\common\Protos\directmethods.proto" />
    <Protobuf Include="..\..\..\common\Protos\twin.proto" />
  </ItemGroup>
</Project>
