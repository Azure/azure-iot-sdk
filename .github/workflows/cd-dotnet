name: cd-dotnet # This only publishes to a private nuget feed that is maintained by service team. We publish there so they can use this sdk for service testing.

on:
  workflow_dispatch:
  schedule:
  - cron: '0 11 * * *'  # Nightly at 4am PST


# only allow one run / branch at a time
concurrency:
  group: ${{ github.workflow }}-${{ github.head_ref || github.ref }}
  cancel-in-progress: true

permissions:
  contents: read
  actions: read
  packages: write
    
jobs:
  build:
    runs-on: ubuntu-latest
    name: cd-dotnet
    timeout-minutes: 30

    steps:
    - uses: actions/checkout@v6

    - run: |
        date="$(date +%F)"
        versionWithSuffix="2.0.0-"$date

        dotnet pack ./dotnet/src/Microsoft.Azure.Devices.Client/Microsoft.Azure.Devices.Client.csproj /p:Version=$versionWithSuffix
        dotnet nuget push "./dotnet/src/Microsoft.Azure.Devices.Client/bin/Release/*.nupkg" --api-key " " https://msazure.pkgs.visualstudio.com/One/_packaging/IoTPlatform/nuget/v3/index.json

