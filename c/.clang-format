---
# Adopted from azure-sdk-for-c's .clang-format so this project reads the same
# way as the SDK it is built on. Keep it in sync when upstream changes.
#
# We'll use defaults from the LLVM style, but with the following differences.
BasedOnStyle: LLVM
AlignAfterOpenBracket: AlwaysBreak
AlignEscapedNewlines: Left
AlignOperands: false
AlignTrailingComments: false
AllowAllParametersOfDeclarationOnNextLine: false
BinPackArguments: false
BinPackParameters: false
BreakBeforeBinaryOperators: All
BreakBeforeBraces: Allman
ColumnLimit: 100
Cpp11BracedListStyle: false
IndentCaseLabels: true
PenaltyReturnTypeOnItsOwnLine: 300
PointerAlignment: Left
StatementMacros: ['_az_PUSH_IGNORE_DEPRECATIONS', '_az_POP_WARNINGS']
# The one deviation from upstream, and it is load-bearing rather than taste.
# LLVM enables SortIncludes, which sorts <cmocka.h> to the top of its block.
# cmocka.h does not include what it needs and documents that <stdarg.h>,
# <stddef.h>, <setjmp.h> and <stdint.h> must precede it, so every unit test
# stops compiling with "unknown type name 'size_t'". Include order is
# load-bearing in C; leave this off.
SortIncludes: false
# Brace every control-flow body, including single statements. This is a real
# defect class rather than taste: an unbraced body silently excludes the line
# added beneath it, which is how goto fail and similar bugs happen. Enforcing it
# here also removes the manual review step -- the formatter adds the braces, so
# they can no longer be forgotten in the first place.
#
# clang-format documents this option as one to review rather than trust blindly,
# since it works without full semantic information. The guard is that a correct
# run only ever ADDS "{" and "}" lines: any deletion or any change to a line of
# actual code means something else happened and the diff needs inspecting.
InsertBraces: true
...
