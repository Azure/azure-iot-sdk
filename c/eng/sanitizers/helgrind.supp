# helgrind suppressions for eng/run-race-detectors.sh. Policy (enforced by
# eng/check-race-suppressions.sh):
# - Third-party code only (Paho, OpenSSL, glibc, ld.so). Never SDK code.
# - Each entry follows a comment giving the upstream file:line and, for Paho,
#   the PAHO_C_TAG it was checked against. Re-check on every tag bump.
# - The first frame is a concrete fun: or obj: line, never "...".

# Paho MQTTAsync.c:657,660 (v1.3.13): MQTTAsync_tostop and sendThread_state
# written without mqttasync_mutex; read by the send thread.
{
   paho-connect-thread-flags
   Helgrind:Race
   fun:MQTTAsync_connect
}

# Paho MQTTAsyncUtils.c:2375 (v1.3.13): MQTTAsync_tostop written without a lock.
{
   paho-stop-tostop
   Helgrind:Race
   fun:MQTTAsync_stop
}

# Paho MQTTAsyncUtils.c:1788-1819 (v1.3.13): sendThread_state and
# MQTTAsync_tostop accessed by the send thread without a lock.
{
   paho-send-thread-flags
   Helgrind:Race
   fun:MQTTAsync_sendThread
}

# Paho MQTTAsync.c:1209 (v1.3.13): Clients.connected read without a lock.
{
   paho-send-connected
   Helgrind:Race
   fun:MQTTAsync_send
}

# Paho MQTTAsyncUtils.c:2662 (v1.3.13): Clients.connected read without a lock.
{
   paho-disconnect1-connected
   Helgrind:Race
   fun:MQTTAsync_disconnect1
}

# Paho Thread.c:463-467 (v1.3.13): Thread_wait_cond adds instead of subtracting
# on the tv_nsec carry, so pthread_cond_timedwait can get tv_nsec >= 1e9 and
# return EINVAL. The send thread logs it and loops.
{
   paho-wait-cond-nsec-carry
   Helgrind:PthAPIerror
   obj:*/vgpreload_helgrind-*.so
   fun:Thread_wait_cond
   fun:MQTTAsync_sendThread
}
