# helgrind suppressions for eng/run-race-detectors.sh. Policy (enforced by
# eng/check-race-suppressions.sh):
# - Third-party code only (Paho, OpenSSL, glibc, ld.so). Never SDK code.
# - Each entry follows a comment giving the upstream file:line and, for Paho,
#   the PAHO_C_TAG it was checked against. Re-check on every tag bump.
# - The first frame is a concrete fun: or obj: line, never "...".

# Paho MQTTAsync.c:684,687 (v1.3.16): MQTTAsync_tostop and sendThread_state
# written without mqttasync_mutex; read by the send thread.
{
   paho-connect-thread-flags
   Helgrind:Race
   fun:MQTTAsync_connect
}

# Paho MQTTAsyncUtils.c:2438 (v1.3.16): MQTTAsync_tostop written without a lock.
{
   paho-stop-tostop
   Helgrind:Race
   fun:MQTTAsync_stop
}

# Paho MQTTAsyncUtils.c:1839-1865 (v1.3.16): sendThread_state and
# MQTTAsync_tostop accessed by the send thread without a lock.
{
   paho-send-thread-flags
   Helgrind:Race
   fun:MQTTAsync_sendThread
}

# Paho MQTTAsync.c:1013 (v1.3.16): receiveThread_id and sendThread_id read
# without a lock; the receive thread writes them (MQTTAsyncUtils.c:2080).
{
   paho-incallback-thread-ids
   Helgrind:Race
   fun:MQTTAsync_inCallback
}

# Paho Thread.c:338 (v1.3.16): helgrind intercepts a condvar signal made inside
# glibc's pthread_cond_timedwait (pthread_cond_wait.c:516) after the mutex was
# released, and reports it as "dubious". The wait is the send thread's own; no
# SDK frame is involved. Seen intermittently.
{
   paho-wait-evt-glibc-internal-signal
   Helgrind:Misc
   obj:*/vgpreload_helgrind-*.so
   fun:__pthread_cond_wait_common
   fun:pthread_cond_timedwait*
   obj:*/vgpreload_helgrind-*.so
   fun:Thread_wait_evt
   fun:MQTTAsync_sendThread
}
