#
# Fails when a build tree (or install prefix) depends on a library it was configured without.
#
#   cmake -DBUILD_DIR=<dir> -DMODE=prepare -P eng/check-dependencies.cmake    (before configuring)
#   cmake -DBUILD_DIR=<dir> -DFORBID=<libs> [options] -P eng/check-dependencies.cmake
#
# FORBID: any of paho, az_mqtt, rust_mqtt, openssl, mbedtls, curl. For every first-party target
# (sources not under _deps/), it checks:
#   - CMake File API: sources, include directories, definitions, link inputs, target dependencies;
#   - headers actually compiled in (ninja -t deps, Ninja generators);
#   - artifacts: ELF NEEDED entries and global nm symbols; PE dependents (dumpbin), .lib symbols;
#   - no fetched copy of the library under _deps/.
# Options:
#   CONFIG=<cfg>            configuration to check (multi-config generators; default: the first)
#   INSTALL_PREFIX=<dir>    also check installed file names, .pc files, exported targets and the
#                           package config's active find_dependency() calls
#   EXPECT_SAMPLES=<list>   adapters (paho, az_mqtt): every sample main.c selecting one must be built
#                           for it, with AZ_IOT_SAMPLE_ADAPTER_<ADAPTER>
#   EXPECT_SAMPLES_EXCEPT=<list>  exempt samples: <folder> (every adapter) or <folder>:<adapter>
#   EXPECT_FAIL=ON          invert the result: a negative control that must find a violation
cmake_minimum_required(VERSION 3.21)

if(NOT BUILD_DIR)
    message(FATAL_ERROR "BUILD_DIR is required")
endif()
get_filename_component(_build "${BUILD_DIR}" ABSOLUTE)
set(_query "${_build}/.cmake/api/v1/query/codemodel-v2")
if(MODE STREQUAL "prepare")
    file(WRITE "${_query}" "")
    return()
endif()

# Path / name patterns (matched lowercased, with build and source prefixes removed).
# Paho's public headers too, for a copy installed outside a directory named paho.
set(_path_paho      "paho|mqttasync|mqttclient|mqttproperties|mqttreasoncodes|mqttsubscribeopts|mqttexportdeclarations|mqttpersistence")
set(_path_az_mqtt   "az_mqtt")
set(_path_rust_mqtt "rust_mqtt|mqtt_rust")
set(_path_openssl   "openssl|libssl|libcrypto")
set(_path_mbedtls   "mbedtls|mbedcrypto|mbedx509|tfpsacrypto|everest|p256m")
set(_path_curl      "curl")
# Global symbol patterns (case-sensitive).
set(_sym_paho       "^_?(MQTTAsync_|MQTTClient_|MQTTProperties_|az_iot_paho_)")
set(_sym_az_mqtt    "^_?(_?az_mqtt|az_iot_az_mqtt_)")
set(_sym_rust_mqtt  "^_?az_iot_rust_mqtt_")
set(_sym_openssl    "^_?(SSL_|SSL_CTX_|EVP_|OPENSSL_|X509_|BIO_|ERR_get_error|CRYPTO_free)")
set(_sym_mbedtls    "^_?(mbedtls_|psa_|tf_psa_)")
set(_sym_curl       "^_?curl_")

set(_known paho az_mqtt rust_mqtt openssl mbedtls curl)
set(_path_re "")
set(_sym_re "")
foreach(_lib IN LISTS FORBID)
    if(NOT _lib IN_LIST _known)
        message(FATAL_ERROR "FORBID: unknown library '${_lib}' (known: ${_known})")
    endif()
    list(APPEND _path_re "${_path_${_lib}}")
    list(APPEND _sym_re "${_sym_${_lib}}")
endforeach()
list(JOIN _path_re "|" _path_re)
list(JOIN _sym_re "|" _sym_re)

set(_violations 0)
function(_violation what)
    message("  ${what}")
    math(EXPR _v "${_violations} + 1")
    set(_violations ${_v} PARENT_SCOPE)
endfunction()

# Lowercased, forward slashes, build and source prefixes removed.
function(_norm out text)
    string(REPLACE "\\" "/" text "${text}")
    string(TOLOWER "${text}" text)
    foreach(_p IN LISTS _strip)
        string(REPLACE "${_p}" "" text "${text}")
    endforeach()
    set(${out} "${text}" PARENT_SCOPE)
endfunction()

function(_matches out text)
    _norm(text "${text}")
    set(${out} FALSE PARENT_SCOPE)
    if(_path_re AND text MATCHES "${_path_re}")
        set(${out} TRUE PARENT_SCOPE)
    endif()
endfunction()

# --- CMake File API --------------------------------------------------------------------------
set(_reply "${_build}/.cmake/api/v1/reply")
file(GLOB _index "${_reply}/index-*.json")
if(NOT EXISTS "${_query}" OR NOT _index)
    message(FATAL_ERROR "No CMake File API reply in ${_build}: run with MODE=prepare before configuring")
endif()
list(SORT _index)
list(GET _index -1 _index)
file(READ "${_index}" _json)
string(JSON _nobj LENGTH "${_json}" objects)
set(_cm "")
math(EXPR _last "${_nobj} - 1")
foreach(_i RANGE ${_last})
    string(JSON _kind GET "${_json}" objects ${_i} kind)
    if(_kind STREQUAL "codemodel")
        string(JSON _cm GET "${_json}" objects ${_i} jsonFile)
    endif()
endforeach()
file(READ "${_reply}/${_cm}" _model)
string(JSON _src_root GET "${_model}" paths source)
string(JSON _bld_root GET "${_model}" paths build)
set(_strip)
foreach(_p "${_bld_root}" "${_src_root}")
    string(REPLACE "\\" "/" _p "${_p}")
    string(TOLOWER "${_p}" _p)
    list(APPEND _strip "${_p}")
endforeach()

string(JSON _ncfg LENGTH "${_model}" configurations)
set(_cfg_index 0)
if(CONFIG)
    set(_cfg_index -1)
    math(EXPR _last "${_ncfg} - 1")
    foreach(_i RANGE ${_last})
        string(JSON _name GET "${_model}" configurations ${_i} name)
        if(_name STREQUAL CONFIG)
            set(_cfg_index ${_i})
        endif()
    endforeach()
    if(_cfg_index EQUAL -1)
        message(FATAL_ERROR "CONFIG ${CONFIG} not in the code model")
    endif()
endif()
string(JSON _cfg_name GET "${_model}" configurations ${_cfg_index} name)

message("Checking ${_build} (${_cfg_name}) for: ${FORBID}")
set(_artifacts)
set(_samples)
set(_ntargets 0)
string(JSON _nt LENGTH "${_model}" configurations ${_cfg_index} targets)
math(EXPR _last "${_nt} - 1")
foreach(_i RANGE ${_last})
    string(JSON _tfile GET "${_model}" configurations ${_cfg_index} targets ${_i} jsonFile)
    file(READ "${_reply}/${_tfile}" _t)
    string(JSON _tname GET "${_t}" name)
    string(JSON _tsrc GET "${_t}" paths source)
    if(_tsrc MATCHES "(^|/)_deps/" OR IS_ABSOLUTE "${_tsrc}")
        continue() # Fetched dependency (its source is outside the project tree).
    endif()
    math(EXPR _ntargets "${_ntargets} + 1")
    set(_hits)
    set(_defs)
    set(_main "")
    # Sources.
    string(JSON _n ERROR_VARIABLE _e LENGTH "${_t}" sources)
    if(NOT _e AND _n GREATER 0)
        math(EXPR _l "${_n} - 1")
        foreach(_j RANGE ${_l})
            string(JSON _p GET "${_t}" sources ${_j} path)
            _matches(_m "${_p}")
            if(_m)
                list(APPEND _hits "source ${_p}")
            endif()
            if(_p MATCHES "(^|/)(samples/.+)/main\\.c$")
                set(_main "${CMAKE_MATCH_2}")
            endif()
        endforeach()
    endif()
    # Includes and definitions.
    string(JSON _n ERROR_VARIABLE _e LENGTH "${_t}" compileGroups)
    if(NOT _e AND _n GREATER 0)
        math(EXPR _l "${_n} - 1")
        foreach(_j RANGE ${_l})
            foreach(_kind includes defines)
                string(JSON _m ERROR_VARIABLE _e LENGTH "${_t}" compileGroups ${_j} ${_kind})
                if(_e OR _m EQUAL 0)
                    continue()
                endif()
                math(EXPR _ml "${_m} - 1")
                foreach(_k RANGE ${_ml})
                    if(_kind STREQUAL "includes")
                        string(JSON _v GET "${_t}" compileGroups ${_j} includes ${_k} path)
                    else()
                        string(JSON _v GET "${_t}" compileGroups ${_j} defines ${_k} define)
                        list(APPEND _defs "${_v}")
                    endif()
                    _matches(_m2 "${_v}")
                    if(_m2)
                        list(APPEND _hits "${_kind} ${_v}")
                    endif()
                endforeach()
            endforeach()
        endforeach()
    endif()
    # Link inputs.
    string(JSON _n ERROR_VARIABLE _e LENGTH "${_t}" link commandFragments)
    if(NOT _e AND _n GREATER 0)
        math(EXPR _l "${_n} - 1")
        foreach(_j RANGE ${_l})
            string(JSON _v GET "${_t}" link commandFragments ${_j} fragment)
            _matches(_m "${_v}")
            if(_m)
                list(APPEND _hits "link ${_v}")
            endif()
        endforeach()
    endif()
    # Target dependencies.
    string(JSON _n ERROR_VARIABLE _e LENGTH "${_t}" dependencies)
    if(NOT _e AND _n GREATER 0)
        math(EXPR _l "${_n} - 1")
        foreach(_j RANGE ${_l})
            string(JSON _v GET "${_t}" dependencies ${_j} id)
            string(REGEX REPLACE "::@.*$" "" _v "${_v}")
            _matches(_m "${_v}")
            if(_m)
                list(APPEND _hits "dependency ${_v}")
            endif()
        endforeach()
    endif()
    list(REMOVE_DUPLICATES _hits)
    foreach(_h IN LISTS _hits)
        _violation("${_tname}: ${_h}")
    endforeach()
    # Artifacts, for the binary checks.
    string(JSON _n ERROR_VARIABLE _e LENGTH "${_t}" artifacts)
    if(NOT _e AND _n GREATER 0)
        math(EXPR _l "${_n} - 1")
        foreach(_j RANGE ${_l})
            string(JSON _v GET "${_t}" artifacts ${_j} path)
            if(NOT IS_ABSOLUTE "${_v}")
                set(_v "${_bld_root}/${_v}")
            endif()
            list(APPEND _artifacts "${_tname}|${_v}")
        endforeach()
    endif()
    if(_main)
        foreach(_d IN LISTS _defs)
            if(_d MATCHES "^AZ_IOT_SAMPLE_ADAPTER_([A-Z_]+)$")
                string(TOLOWER "${CMAKE_MATCH_1}" _a)
                list(APPEND _samples "${_main}|${_a}|${_tname}")
            endif()
        endforeach()
    endif()
endforeach()
message("  ${_ntargets} first-party targets in the code model")

# --- Headers compiled in ---------------------------------------------------------------------
if(_path_re)
    set(_ninja_file "")
    if(EXISTS "${_build}/build-${_cfg_name}.ninja")
        set(_ninja_file "-f" "build-${_cfg_name}.ninja")
    elseif(NOT EXISTS "${_build}/build.ninja")
        message(FATAL_ERROR "Not a Ninja build tree: the compiled headers cannot be checked")
    endif()
    find_program(_ninja NAMES ninja REQUIRED)
    execute_process(COMMAND "${_ninja}" -C "${_build}" ${_ninja_file} -t deps
        OUTPUT_VARIABLE _deps RESULT_VARIABLE _rc)
    if(NOT _rc EQUAL 0)
        message(FATAL_ERROR "ninja -t deps failed in ${_build}")
    endif()
    string(REPLACE ";" "\\;" _deps "${_deps}")
    string(REPLACE "\n" ";" _deps "${_deps}")
    set(_obj "")
    set(_nobjs 0)
    foreach(_line IN LISTS _deps)
        if(_line MATCHES "^([^ ].*): #deps")
            set(_obj "${CMAKE_MATCH_1}")
            if(_obj MATCHES "(^|/)_deps/")
                set(_obj "") # A fetched dependency's own objects.
            else()
                math(EXPR _nobjs "${_nobjs} + 1")
            endif()
        elseif(_obj AND _line MATCHES "^    (.+)$")
            _matches(_m "${CMAKE_MATCH_1}")
            if(_m)
                _violation("${_obj}: includes ${CMAKE_MATCH_1}")
            endif()
        endif()
    endforeach()
    message("  ${_nobjs} first-party objects in the dependency log")
endif()

# --- Artifacts --------------------------------------------------------------------------------
if(_sym_re)
    if(CMAKE_HOST_WIN32)
        find_program(_dumpbin NAMES dumpbin REQUIRED)
    else()
        find_program(_nm NAMES nm REQUIRED)
        find_program(_readelf NAMES readelf REQUIRED)
    endif()
    # A failed inspection is an error, never "no dependency" (nor a negative control's hit).
    macro(_tool_ok tool)
        if(NOT _rc EQUAL 0)
            message(FATAL_ERROR "${tool} failed (${_rc}) on ${_f}")
        endif()
    endmacro()
    set(_nbin 0)
    foreach(_a IN LISTS _artifacts)
        string(REGEX REPLACE "^([^|]*)\\|(.*)$" "\\1" _tname "${_a}")
        string(REGEX REPLACE "^([^|]*)\\|(.*)$" "\\2" _f "${_a}")
        if(NOT EXISTS "${_f}")
            continue() # Not built (EXCLUDE_FROM_ALL, or another configuration).
        endif()
        set(_needed "")
        set(_syms "")
        if(CMAKE_HOST_WIN32)
            if(_f MATCHES "\\.(exe|dll)$")
                execute_process(COMMAND "${_dumpbin}" -nologo -dependents "${_f}"
                    OUTPUT_VARIABLE _needed RESULT_VARIABLE _rc)
            elseif(_f MATCHES "\\.lib$")
                execute_process(COMMAND "${_dumpbin}" -nologo -symbols "${_f}"
                    OUTPUT_VARIABLE _out RESULT_VARIABLE _rc)
                string(REGEX MATCHALL "External *\\| *[^ \r\n]+" _syms "${_out}")
                list(TRANSFORM _syms REPLACE "^External *\\| *" "")
            else()
                continue()
            endif()
            _tool_ok(dumpbin)
        else()
            file(READ "${_f}" _magic LIMIT 8 HEX)
            if(_magic MATCHES "^7f454c46")
                execute_process(COMMAND "${_readelf}" -d "${_f}" OUTPUT_VARIABLE _out
                    RESULT_VARIABLE _rc)
                _tool_ok(readelf)
                string(REGEX MATCHALL "\\(NEEDED\\)[^\n]*" _needed "${_out}")
            elseif(NOT _magic MATCHES "^213c617263683e")
                continue() # Neither ELF nor an archive.
            endif()
            execute_process(COMMAND "${_nm}" -P "${_f}" OUTPUT_VARIABLE _out ERROR_VARIABLE _err
                RESULT_VARIABLE _rc)
            _tool_ok(nm)
            string(REPLACE ";" "" _out "${_out}")
            # Global and undefined symbols only: a library's file-local names are its own business.
            string(REGEX MATCHALL "(^|\n)[^ \n:]+ [A-Zvw] " _syms "${_out}")
            list(TRANSFORM _syms REPLACE "^\n?([^ ]+) .*$" "\\1")
        endif()
        math(EXPR _nbin "${_nbin} + 1")
        string(REPLACE "\n" ";" _needed "${_needed}")
        foreach(_n IN LISTS _needed)
            _matches(_m "${_n}")
            if(_m)
                string(STRIP "${_n}" _n)
                _violation("${_tname}: ${_f} needs ${_n}")
            endif()
        endforeach()
        set(_bad "")
        foreach(_s IN LISTS _syms)
            if(_s MATCHES "${_sym_re}")
                list(APPEND _bad "${_s}")
            endif()
        endforeach()
        if(_bad)
            list(REMOVE_DUPLICATES _bad)
            list(LENGTH _bad _nbad)
            list(SUBLIST _bad 0 3 _bad)
            _violation("${_tname}: ${_f} has ${_nbad} symbol(s), e.g. ${_bad}")
        endif()
    endforeach()
    message("  ${_nbin} binaries inspected")
    if(_nbin EQUAL 0)
        message(FATAL_ERROR "No built artifact found: build the tree before checking it")
    endif()
endif()

# --- Fetched copies ---------------------------------------------------------------------------
file(GLOB _fetched LIST_DIRECTORIES true "${_build}/_deps/*-src")
foreach(_d IN LISTS _fetched)
    get_filename_component(_name "${_d}" NAME)
    _matches(_m "${_name}")
    if(_m)
        _violation("fetched: ${_d}")
    endif()
endforeach()

# --- Install prefix ---------------------------------------------------------------------------
if(INSTALL_PREFIX)
    get_filename_component(_prefix "${INSTALL_PREFIX}" ABSOLUTE)
    list(APPEND _strip "${_prefix}")
    string(TOLOWER "${_strip}" _strip)
    string(REPLACE "\\" "/" _strip "${_strip}")
    file(GLOB_RECURSE _files RELATIVE "${_prefix}" "${_prefix}/*")
    foreach(_f IN LISTS _files)
        _matches(_m "${_f}")
        if(_m)
            _violation("installed: ${_f}")
        elseif(_f MATCHES "\\.pc$|-targets[^/]*\\.cmake$")
            file(STRINGS "${_prefix}/${_f}" _lines)
            foreach(_line IN LISTS _lines)
                _matches(_m "${_line}")
                if(_m)
                    _violation("installed: ${_f}: ${_line}")
                endif()
            endforeach()
        elseif(_f MATCHES "-config\\.cmake$")
            # Only find_dependency() calls the configured file actually makes.
            file(STRINGS "${_prefix}/${_f}" _lines)
            set(_active TRUE)
            set(_stack)
            foreach(_line IN LISTS _lines)
                string(STRIP "${_line}" _line)
                if(_line MATCHES "^if\\((ON|OFF)\\)$")
                    list(APPEND _stack "${_active}|${CMAKE_MATCH_1}")
                    if(CMAKE_MATCH_1 STREQUAL "OFF")
                        set(_active FALSE)
                    endif()
                elseif(_line MATCHES "^if\\(")
                    list(APPEND _stack "${_active}|?")
                elseif(_line MATCHES "^else\\(\\)$" AND _stack)
                    list(GET _stack -1 _top)
                    string(REGEX REPLACE "\\|.*$" "" _outer "${_top}")
                    if(_top MATCHES "\\|ON$")
                        set(_active FALSE)
                    elseif(_top MATCHES "\\|OFF$")
                        set(_active ${_outer})
                    endif()
                elseif(_line MATCHES "^endif\\(" AND _stack)
                    list(GET _stack -1 _top)
                    list(REMOVE_AT _stack -1)
                    string(REGEX REPLACE "\\|.*$" "" _active "${_top}")
                elseif(_active AND _line MATCHES "^find_dependency\\(")
                    _matches(_m "${_line}")
                    if(_m)
                        _violation("installed: ${_f}: ${_line}")
                    endif()
                endif()
            endforeach()
        endif()
    endforeach()
    list(LENGTH _files _n)
    message("  ${_n} installed files inspected")
endif()

# --- Samples ----------------------------------------------------------------------------------
if(EXPECT_SAMPLES)
    file(GLOB_RECURSE _mains "${_src_root}/samples/*/main.c")
    foreach(_main IN LISTS _mains)
        if(_main MATCHES "/esp32/")
            continue()
        endif()
        get_filename_component(_dir "${_main}" DIRECTORY)
        get_filename_component(_name "${_dir}" NAME)
        # Samples are identified by folder (samples/<group>/<name>): names repeat across groups.
        file(RELATIVE_PATH _rel "${_src_root}" "${_dir}")
        file(READ "${_main}" _text)
        foreach(_a IN LISTS EXPECT_SAMPLES)
            string(TOUPPER "${_a}" _A)
            if(NOT _text MATCHES "AZ_IOT_SAMPLE_ADAPTER_${_A}" OR _name IN_LIST EXPECT_SAMPLES_EXCEPT
               OR "${_name}:${_a}" IN_LIST EXPECT_SAMPLES_EXCEPT)
                continue()
            endif()
            set(_found "")
            foreach(_s IN LISTS _samples)
                string(FIND "${_s}" "${_rel}|${_a}|" _pos)
                if(_pos EQUAL 0)
                    string(LENGTH "${_rel}|${_a}|" _len)
                    string(SUBSTRING "${_s}" ${_len} -1 _found)
                endif()
            endforeach()
            set(_built FALSE)
            foreach(_art IN LISTS _artifacts)
                if(_found AND _art MATCHES "^${_found}\\|(.*)$")
                    if(EXISTS "${CMAKE_MATCH_1}")
                        set(_built TRUE)
                    endif()
                endif()
            endforeach()
            if(NOT _built)
                _violation("sample ${_rel} (${_a}): not built")
            endif()
        endforeach()
    endforeach()
endif()

if(EXPECT_FAIL)
    if(_violations EQUAL 0)
        message(FATAL_ERROR "Negative control: expected a violation for ${FORBID}, found none")
    endif()
    message("Negative control passed: ${_violations} violation(s) found, as expected")
elseif(_violations GREATER 0)
    message(FATAL_ERROR "${_violations} dependency violation(s) for: ${FORBID}")
else()
    message("No dependency on: ${FORBID}")
endif()
