{
    "version": 6,
    "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
            },
            "environment": {
                "_az_iot_VCPKG_HINT": "Set VCPKG_ROOT and pass -DCMAKE_TOOLCHAIN_FILE=$VCPKG_ROOT/scripts/buildsystems/vcpkg.cmake to opt-in to vcpkg-managed deps (Paho, OpenSSL)."
            }
        },
        {
            "name": "linux-base",
            "hidden": true,
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "AZ_IOT_BUILD_CONFORMANCE_TESTS": "ON"
            }
        },
        {
            "name": "linux-gcc-debug",
            "inherits": "linux-base",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_BUILD_TYPE": "Debug",
                "AZ_IOT_BUILD_TESTS": "ON"
            },
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
        },
        {
            "name": "linux-clang-debug",
            "inherits": "linux-base",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_BUILD_TYPE": "Debug",
                "AZ_IOT_BUILD_TESTS": "ON"
            },
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
        },
        {
            "name": "linux-gcc-coverage",
            "inherits": "linux-base",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_FLAGS": "-O0",
                "AZ_IOT_BUILD_TESTS": "ON",
                "AZ_IOT_ENABLE_COVERAGE": "ON",
                "AZ_IOT_WITH_PAHO": "ON",
                "AZ_IOT_WITH_RUST_MQTT": "OFF",
                "AZ_IOT_WITH_ADU_CRYPTO_OPENSSL": "ON",
                "AZ_IOT_WITH_CERT_PROVIDER_MANAGED": "ON"
            },
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
        },
        {
            "name": "windows-msvc-debug",
            "inherits": "base",
            "generator": "Ninja Multi-Config",
            "cacheVariables": {
                "AZ_IOT_BUILD_TESTS": "ON"
            },
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
        }
    ],
    "buildPresets": [
        { "name": "linux-gcc-debug",   "configurePreset": "linux-gcc-debug" },
        { "name": "linux-clang-debug", "configurePreset": "linux-clang-debug" },
        { "name": "linux-gcc-coverage", "configurePreset": "linux-gcc-coverage" },
        { "name": "windows-msvc-debug", "configurePreset": "windows-msvc-debug", "configuration": "Debug" }
    ],
    "testPresets": [
        { "name": "linux-gcc-debug",   "configurePreset": "linux-gcc-debug",   "output": { "outputOnFailure": true } },
        { "name": "linux-clang-debug", "configurePreset": "linux-clang-debug", "output": { "outputOnFailure": true } },
        { "name": "linux-gcc-coverage", "configurePreset": "linux-gcc-coverage", "output": { "outputOnFailure": true } },
        { "name": "windows-msvc-debug", "configurePreset": "windows-msvc-debug", "configuration": "Debug", "output": { "outputOnFailure": true } }
    ]
}
