{
    "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
    "name": "azure-iot-sdk",
    "version-semver": "1.0.0-preview",
    "description": "C99 client SDK for Azure IoT Hub (MQTTv3 + MQTTv5)",
    "builtin-baseline": "9e593bb18ea69cc5095e012465dcd675a822ed0d",
    "dependencies": [
    ],
    "features": {
        "paho": {
            "description": "Build with the Paho-C MQTT adapter (OpenSSL for TLS)",
            "dependencies": [
                "openssl"
            ]
        },
        "installed-paho": {
            "description": "vcpkg's Paho-C instead of building it; configure with -DAZ_IOT_USE_INSTALLED_PAHO=ON",
            "dependencies": [
                "openssl",
                {
                    "name": "paho-mqtt",
                    "version>=": "1.3.13"
                }
            ]
        },
        "curl": {
            "description": "libcurl for the HTTPS file upload sample (bring-your-own HTTP client)",
            "dependencies": [
                "curl"
            ]
        },
        "tests": {
            "description": "Build unit tests",
            "dependencies": []
        }
    },
    "default-features": []
}
