# clang-tidy configuration for first-party C code (src, adapters, samples). Run by
# eng/clang-tidy.sh and the ci-c-static-analysis workflow. Every finding is an error.
#
# Disabled checks, and why:
#   clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling
#                                       asks for Annex K (*_s) functions, which glibc lacks.
#   bugprone-easily-swappable-parameters  flags public API signatures; not a defect finder.
#   bugprone-branch-clone               identical branches here are deliberate, for readability.
#   bugprone-inc-dec-in-conditions      C++ sequencing concern; && and || order evaluation in C.
#   bugprone-casting-through-void       the only way to reach opaque storage in C.
#   misc-include-cleaner                include hygiene; not a defect finder.
#   clang-analyzer-optin.performance.Padding  field order of public structs is API.
Checks: >-
  -*,
  clang-analyzer-*,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-branch-clone,
  -bugprone-inc-dec-in-conditions,
  -bugprone-casting-through-void,
  cert-*,
  misc-*,
  -misc-include-cleaner,
  -clang-analyzer-optin.performance.Padding
WarningsAsErrors: '*'
# First-party headers only; fetched dependencies live under c/build or c/deps.
HeaderFilterRegex: '.*/c/(inc|src|adapters|samples)/.*'
CheckOptions:
  # Feature-test macros must be defined with their reserved names.
  bugprone-reserved-identifier.AllowedIdentifiers: '_POSIX_C_SOURCE;_GNU_SOURCE;_DEFAULT_SOURCE;_CRT_SECURE_NO_WARNINGS'
  cert-dcl37-c.AllowedIdentifiers: '_POSIX_C_SOURCE;_GNU_SOURCE;_DEFAULT_SOURCE;_CRT_SECURE_NO_WARNINGS'
  cert-dcl51-cpp.AllowedIdentifiers: '_POSIX_C_SOURCE;_GNU_SOURCE;_DEFAULT_SOURCE;_CRT_SECURE_NO_WARNINGS'
  # clang-tidy 18 default list, minus console/stream output functions (fprintf, fputs, putc,
  # ...), whose results the code does not act on. Buffer formatting (snprintf, ...) stays checked.
  cert-err33-c.CheckedFunctions: >-
    ::aligned_alloc; ::asctime_s; ::at_quick_exit; ::atexit; ::bsearch; ::bsearch_s; ::btowc;
    ::c16rtomb; ::c32rtomb; ::calloc; ::clock; ::cnd_broadcast; ::cnd_init; ::cnd_signal;
    ::cnd_timedwait; ::cnd_wait; ::ctime_s; ::fclose; ::fflush; ::fgetc; ::fgetpos; ::fgets;
    ::fgetwc; ::fopen; ::fopen_s; ::fread; ::freopen; ::freopen_s; ::fscanf; ::fscanf_s;
    ::fseek; ::fsetpos; ::ftell; ::fwrite; ::fwscanf; ::fwscanf_s; ::getc; ::getchar;
    ::getenv; ::getenv_s; ::gets_s; ::getwc; ::getwchar; ::gmtime; ::gmtime_s; ::localtime;
    ::localtime_s; ::malloc; ::mbrtoc16; ::mbrtoc32; ::mbsrtowcs; ::mbsrtowcs_s; ::mbstowcs;
    ::mbstowcs_s; ::memchr; ::mktime; ::mtx_init; ::mtx_lock; ::mtx_timedlock; ::mtx_trylock;
    ::mtx_unlock; ::raise; ::realloc; ::remove; ::rename; ::scanf; ::scanf_s; ::setlocale;
    ::setvbuf; ::signal; ::snprintf; ::snprintf_s; ::sprintf; ::sprintf_s; ::sscanf;
    ::sscanf_s; ::strchr; ::strerror_s; ::strftime; ::strpbrk; ::strrchr; ::strstr; ::strtod;
    ::strtof; ::strtoimax; ::strtok; ::strtok_s; ::strtol; ::strtold; ::strtoll; ::strtoul;
    ::strtoull; ::strtoumax; ::strxfrm; ::swprintf; ::swprintf_s; ::swscanf; ::swscanf_s;
    ::thrd_create; ::thrd_detach; ::thrd_join; ::thrd_sleep; ::time; ::timespec_get;
    ::tmpfile; ::tmpfile_s; ::tmpnam; ::tmpnam_s; ::tss_create; ::tss_get; ::tss_set;
    ::ungetc; ::ungetwc; ::vfscanf; ::vfscanf_s; ::vfwscanf; ::vfwscanf_s; ::vscanf;
    ::vscanf_s; ::vsnprintf; ::vsnprintf_s; ::vsprintf; ::vsprintf_s; ::vsscanf; ::vsscanf_s;
    ::vswprintf; ::vswprintf_s; ::vswscanf; ::vswscanf_s; ::vwscanf; ::vwscanf_s; ::wcrtomb;
    ::wcschr; ::wcsftime; ::wcspbrk; ::wcsrchr; ::wcsrtombs; ::wcsrtombs_s; ::wcsstr;
    ::wcstod; ::wcstof; ::wcstoimax; ::wcstok; ::wcstok_s; ::wcstol; ::wcstold; ::wcstoll;
    ::wcstombs; ::wcstombs_s; ::wcstoul; ::wcstoull; ::wcstoumax; ::wcsxfrm; ::wctob;
    ::wctrans; ::wctype; ::wmemchr; ::wscanf; ::wscanf_s
