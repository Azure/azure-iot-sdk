prefix=@AZ_IOT_PC_PREFIX@
exec_prefix=${prefix}
libdir=@AZ_IOT_PC_LIBDIR@
includedir=@AZ_IOT_PC_INCLUDEDIR@

Name: azure-iot-sdk-@AZ_IOT_PC_COMPONENT@
Description: @AZ_IOT_PC_DESCRIPTION@
URL: https://github.com/Azure/azure-iot-sdk
Version: @AZ_IOT_VERSION_FULL@
Requires: @AZ_IOT_PC_REQUIRES@
Requires.private: @AZ_IOT_PC_REQUIRES_PRIVATE@
Cflags: @AZ_IOT_PC_CFLAGS@
Libs: -L${libdir} @AZ_IOT_PC_LIBS@
Libs.private: @AZ_IOT_PC_LIBS_PRIVATE@
