@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Static libraries: the private dependencies of every installed target must be
# found here too. OpenSSL comes first, since Paho's exported targets name it.
if(@AZ_IOT_PACKAGE_NEEDS_OPENSSL@)
    find_dependency(OpenSSL @AZ_IOT_PACKAGE_OPENSSL_MIN@)
endif()
if(@AZ_IOT_PACKAGE_NEEDS_PAHO@)
    # The Paho build installed alongside this package, not another one.
    find_dependency(eclipse-paho-mqtt-c CONFIG HINTS "${PACKAGE_PREFIX_DIR}" NO_DEFAULT_PATH)
endif()
if(@AZ_IOT_PACKAGE_NEEDS_THREADS@)
    find_dependency(Threads)
endif()
if(@AZ_IOT_PACKAGE_NEEDS_MBEDTLS@)
    find_dependency(MbedTLS CONFIG)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/azure-iot-sdk-targets.cmake")

foreach(_az_iot_comp IN ITEMS @AZ_IOT_PACKAGE_COMPONENTS@)
    set(azure-iot-sdk_${_az_iot_comp}_FOUND TRUE)
endforeach()
unset(_az_iot_comp)

check_required_components(azure-iot-sdk)
