@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Static libraries: the private dependencies of every installed target must be
# found here too. OpenSSL comes first, since Paho's exported targets name it.
if(@AZ_IOT_PACKAGE_NEEDS_OPENSSL@)
    find_dependency(OpenSSL @AZ_IOT_PACKAGE_OPENSSL_MIN@)
endif()
if(@AZ_IOT_USE_INSTALLED_AZURE_SDK_FOR_C@)
    # Built against an installed azure-sdk-for-c: find it the same way.
    set(_az_iot_module_path "${CMAKE_MODULE_PATH}")
    list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
    # Exactly the version built against: its types are embedded in public SDK structs.
    find_dependency(azure-sdk-for-c @AZ_IOT_PACKAGE_AZURE_SDK_FOR_C_VERSION@ EXACT)
    # The manifest layout the SDK and this parser were built with.
    if(TARGET az::iot::hub)
        set_property(TARGET az::iot::hub APPEND PROPERTY
            INTERFACE_COMPILE_DEFINITIONS "@AZ_IOT_SU_LIMIT_DEFINITIONS@")
    endif()
    set(CMAKE_MODULE_PATH "${_az_iot_module_path}")
    unset(_az_iot_module_path)
endif()
if(@AZ_IOT_PACKAGE_NEEDS_PAHO@)
    if(@AZ_IOT_USE_INSTALLED_PAHO@)
        find_dependency(eclipse-paho-mqtt-c @AZ_IOT_PAHO_VERSION@ CONFIG)
    else()
        # The Paho build installed alongside this package, not another one.
        find_dependency(eclipse-paho-mqtt-c CONFIG HINTS "${PACKAGE_PREFIX_DIR}" NO_DEFAULT_PATH)
    endif()
endif()
if(@AZ_IOT_PACKAGE_NEEDS_THREADS@)
    find_dependency(Threads)
endif()
if(@AZ_IOT_PACKAGE_NEEDS_MBEDTLS@)
    find_dependency(MbedTLS CONFIG)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/azure-iot-sdk-targets.cmake")

foreach(_az_iot_comp IN ITEMS @AZ_IOT_PACKAGE_COMPONENTS@)
    set(azure-iot-sdk_${_az_iot_comp}_FOUND TRUE)
endforeach()
unset(_az_iot_comp)

check_required_components(azure-iot-sdk)
