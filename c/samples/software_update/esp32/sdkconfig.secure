# Opt-in production security profile (Espressif-recommended set). Not applied by default.
#
# IRREVERSIBLE: the first boot of an image built with this profile burns eFuses
# (Secure Boot v2, flash encryption in release mode). Try it on a spare board, or first with
# sdkconfig.secure_virtual_efuse, which burns nothing.
#
#   idf.py -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.secure" build
#
# ESP32 below chip revision v3.0 has no Secure Boot v2: also append sdkconfig.secure_esp32_legacy.
# Target-specific settings are in sdkconfig.secure.<target>, which ESP-IDF applies automatically.

# --- Partition table with nvs_keys (and efuse_em for virtual eFuse testing) --
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_secure.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_secure.csv"
# Secure Boot and flash encryption enlarge the bootloader.
CONFIG_PARTITION_TABLE_OFFSET=0xD000

# --- Secure Boot v2 ----------------------------------------------------------
# Generate the key once and keep it private (never commit it):
#   espsecure generate-signing-key --version 2 --scheme rsa3072 secure_boot_signing_key.pem
CONFIG_SECURE_BOOT=y
CONFIG_SECURE_BOOT_V2_ENABLED=y
CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES=y
CONFIG_SECURE_BOOT_SIGNING_KEY="secure_boot_signing_key.pem"
CONFIG_SECURE_BOOT_FLASH_BOOTLOADER_DEFAULT=y

# --- Flash encryption --------------------------------------------------------
CONFIG_SECURE_FLASH_ENC_ENABLED=y
CONFIG_SECURE_FLASH_ENCRYPTION_MODE_RELEASE=y

# --- NVS encryption (Wi-Fi credentials, software updates resume state) ---------
# Keys protected by flash encryption; HMAC-capable targets override this.
CONFIG_NVS_ENCRYPTION=y
CONFIG_NVS_SEC_KEY_PROTECT_USING_FLASH_ENC=y
