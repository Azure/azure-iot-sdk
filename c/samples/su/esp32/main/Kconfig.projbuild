menu "Software Updates ESP32 Sample Configuration"

    config SU_WIFI_SSID
        string "Wi-Fi SSID"
        default "my-ssid"
        help
            SSID of the Wi-Fi network the device joins to reach Azure.

    config SU_WIFI_PASSWORD
        string "Wi-Fi password"
        default "my-password"
        help
            WPA2 password for the configured Wi-Fi network.

    config SU_DPS_ID_SCOPE
        string "DPS ID scope"
        default "0ne00000000"
        help
            Device Provisioning Service ID scope (AZ_IOT_DPS_ID_SCOPE from the
            Initialize-SuSampleEnvironment.ps1 output).

    config SU_DPS_REGISTRATION_ID
        string "DPS registration id (device id)"
        default "su-esp32-device"
        help
            DPS registration id. Must match the CN of the embedded device
            certificate and the X.509 enrollment created by the init script.

endmenu
